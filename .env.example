# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon console > Connect, pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth secret, min 32 chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Base URL of the app
BETTER_AUTH_URL="http://localhost:3000"

# --- Catalogue sources (optional: a row without its source shows demo titles) ---

# TMDB, for the anime row. v3 API key or v4 read access token:
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Twitch, for the gaming row. Register an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# TheSportsDB, for the sports row. Leave empty to use the public free key.
SPORTSDB_API_KEY=""

# The Internet Archive (indie row) needs no key.

# --- Your library (optional: without it the "Your library" row is hidden) ---

# Raw link to videos.json in your video repository (see the sidflix-videos template), e.g.
# https://raw.githubusercontent.com/YOUR_GITHUB_NAME/sidflix-videos/main/videos.json
LIBRARY_MANIFEST_URL=""
