{
  "name": "sidflix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "library:artwork": "node --conditions=react-server --import tsx scripts/sync-library-artwork.ts",
    "compression:test": "node --conditions=react-server --import tsx scripts/test-compression.ts",
    "sports:sync": "node --import tsx scripts/sync-sports-streams.ts",
    "movies:sync": "node --import tsx scripts/sync-movie-channels.ts",
    "auth:generate": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes",
    "accounts:setup": "node --conditions=react-server --import tsx scripts/setup-accounts.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yify-api": "^1.1.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
